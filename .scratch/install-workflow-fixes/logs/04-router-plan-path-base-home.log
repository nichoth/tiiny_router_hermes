{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mmoeq8K3tzd6CB1DCCzsAM","type":"tool_result","content":"1\t\"\"\"The plugin source tree works from wherever it is copied.\n2\t\n3\tThe installer copies ``tiiny-router/`` as one tree into\n4\t``$HERMES_HOME/plugins/tiiny-router/``. These tests copy it to an arbitrary\n5\ttemporary path and exercise it there, so any lookup that depends on the\n6\trepo layout (or on some other fixed path) fails here.\n7\t\n8\tRun with: ``python3 -B test/test_installed_tree.py``\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\timport os\n14\timport shutil\n15\timport subprocess\n16\timport sys\n17\timport tempfile\n18\timport unittest\n19\tfrom pathlib import Path\n20\t\n21\tSOURCE = Path(__file__).resolve().parent.parent / \"tiiny-router\"\n22\t\n23\t_OFFLINE_ENV = {\"PYTHONDONTWRITEBYTECODE\": \"1\"}\n24\t\n25\t\n26\tclass CopiedTree(unittest.TestCase):\n27\t    def setUp(self) -> None:\n28\t        self._tmp = tempfile.TemporaryDirectory()\n29\t        tmp = Path(self._tmp.name)\n30\t        self.home = tmp / \"home\"\n31\t        self.home.mkdir()\n32\t        self.plugin = tmp / \"somewhere\" / \"else\" / \"tiiny-router\"\n33\t        shutil.copytree(\n34\t            SOURCE,\n35\t            self.plugin,\n36\t            ignore=shutil.ignore_patterns(\"__pycache__\"),\n37\t        )\n38\t\n39\t    def tearDown(self) -> None:\n40\t        self._tmp.cleanup()\n41\t\n42\t    def run_script(self, name: str, *args: str):\n43\t        env = {\n44\t            **os.environ,\n45\t            **_OFFLINE_ENV,\n46\t            \"HOME\": str(self.home),\n47\t            \"HERMES_HOME\": str(self.home / \".hermes\"),\n48\t        }\n49\t        return subprocess.run(\n50\t            [sys.executable, \"-B\", str(self.plugin / \"scripts\" / name), *args],\n51\t            cwd=self.home,\n52\t            env=env,\n53\t            capture_output=True,\n54\t            text=True,\n55\t            timeout=60,\n56\t        )\n57\t\n58\t    def test_route_check_runs(self) -> None:\n59\t        result = self.run_script(\"route_check.py\", \"--all\")\n60\t        self.assertEqual(result.returncode, 0, result.stderr)\n61\t\n62\t    def test_route_check_routes_a_goal(self) -> None:\n63\t        result = self.run_script(\n64\t            \"route_check.py\", \"write a python function that parses dates\"\n65\t        )\n66\t        self.assertEqual(result.returncode, 0, result.stderr)\n67\t\n68\t    def code_tier_rows(self) -> list[tuple[str, int, int]]:\n69\t        \"\"\"The ``code`` tier's (model, NPU %, context) rows from --all.\"\"\"\n70\t        result = self.run_script(\"route_check.py\", \"--all\")\n71\t        self.assertEqual(result.returncode, 0, result.stderr)\n72\t        rows = []\n73\t        for line in result.stdout.splitlines():\n74\t            cells = line.lstrip(\"* \").split()\n75\t            if len(cells) == 4 and cells[0] == \"code\":\n76\t                rows.append((cells[1], int(cells[2].rstrip(\"%\")),\n77\t                             int(cells[3])))\n78\t        return rows\n79\t\n80\t    def test_code_tier_offers_ornith_1_5_turbo(self) -> None:\n81\t        rows = self.code_tier_rows()\n82\t        self.assertEqual(rows[0][0], \"Qwen/Qwen3.6-35B-A3B\")\n83\t        self.assertEqual(\n84\t            rows[1], (\"ornith-ai/Ornith-1.5-35B-A3B-Turbo\", 54, 262144)\n85\t        )\n86\t\n87\t    def test_route_check_never_reports_ornith_1_0(self) -> None:\n88\t        models = [row[0] for row in self.code_tier_rows()]\n89\t        self.assertNotIn(\"deepreinforce-ai/Ornith-1.0-35B\", models)\n90\t        result = self.run_script(\n91\t            \"route_check.py\", \"--tier\", \"code\", \"--alternatives\",\n92\t            \"fix the failing build\",\n93\t        )\n94\t        self.assertEqual(result.returncode, 0, result.stderr)\n95\t        self.assertNotIn(\"Ornith-1.0-35B\", result.stdout)\n96\t\n97\t    def test_controller_loads_tier_table(self) -> None:\n98\t        # The controller loads the tier table at import, before argparse\n99\t        # runs, so --help exits non-zero if the table cannot be found.\n100\t        result = self.run_script(\"tiiny_ctl.py\", \"--help\")\n101\t        self.assertEqual(result.returncode, 0, result.stderr)\n102\t\n103\t    def test_backend_loads_controller(self) -> None:\n104\t        # Import the backend as a package from the copy, with a stub for\n105\t        # the one Hermes module it imports, and report whether it found\n106\t        # the controller.\n107\t        probe = self.home / \"probe.py\"\n108\t        probe.write_text(_IMPORT_PROBE)\n109\t        env = {\n110\t            **os.environ,\n111\t            **_OFFLINE_ENV,\n112\t            \"HOME\": str(self.home),\n113\t            \"HERMES_HOME\": str(self.home / \".hermes\"),\n114\t        }\n115\t        result = subprocess.run(\n116\t            [sys.executable, \"-B\", str(probe), str(self.plugin)],\n117\t            cwd=self.home,\n118\t            env=env,\n119\t            capture_output=True,\n120\t            text=True,\n121\t            timeout=60,\n122\t        )\n123\t        self.assertEqual(result.returncode, 0, result.stderr)\n124\t        self.assertEqual(result.stdout.strip(), \"controller loaded\")\n125\t\n126\t\n127\t_IMPORT_PROBE = '''\n128\timport importlib.util\n129\timport sys\n130\timport types\n131\tfrom pathlib import Path\n132\t\n133\tstub = types.ModuleType(\"agent.delegation_provider\")\n134\tstub.DelegationProvider = type(\"DelegationProvider\", (), {})\n135\tstub.DelegationRouteError = type(\"DelegationRouteError\", (Exception,), {})\n136\tsys.modules[\"agent\"] = types.ModuleType(\"agent\")\n137\tsys.modules[\"agent.delegation_provider\"] = stub\n138\t\n139\tplugin = Path(sys.argv[1])\n140\tspec = importlib.util.spec_from_file_location(\n141\t    \"tiiny_router\",\n142\t    plugin / \"__init__.py\",\n143\t    submodule_search_locations=[str(plugin)],\n144\t)\n145\tmodule = importlib.util.module_from_spec(spec)\n146\tsys.modules[\"tiiny_router\"] = module\n147\tspec.loader.exec_module(module)\n148\tprint(\"controller loaded\" if module.ctl is not None else \"no controller\")\n149\t'''\n150\t\n151\t\n152\tif __name__ == \"__main__\":\n153\t    unittest.main()\n154\t"}]},"parent_tool_use_id":null,"session_id":"b63ad6aa-1dd3-487c-8e9f-f16892a2390c","uuid":"dfd68176-a275-48aa-aab4-5be76e03f89a","timestamp":"2026-11-22T01:18:17.529Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/tiiny_router_hermes.install-workflow-fixes-04-router-plan-path-base-home/test/test_installed_tree.py","content":"\"\"\"The plugin source tree works from wherever it is copied.\n\nThe installer copies ``tiiny-router/`` as one tree into\n``$HERMES_HOME/plugins/tiiny-router/``. These tests copy it to an arbitrary\ntemporary path and exercise it there, so any lookup that depends on the\nrepo layout (or on some other fixed path) fails here.\n\nRun with: ``python3 -B test/test_installed_tree.py``\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nSOURCE = Path(__file__).resolve().parent.parent / \"tiiny-router\"\n\n_OFFLINE_ENV = {\"PYTHONDONTWRITEBYTECODE\": \"1\"}\n\n\nclass CopiedTree(unittest.TestCase):\n    def setUp(self) -> None:\n        self._tmp = tempfile.TemporaryDirectory()\n        tmp = Path(self._tmp.name)\n        self.home = tmp / \"home\"\n        self.home.mkdir()\n        self.plugin = tmp / \"somewhere\" / \"else\" / \"tiiny-router\"\n        shutil.copytree(\n            SOURCE,\n            self.plugin,\n            ignore=shutil.ignore_patterns(\"__pycache__\"),\n        )\n\n    def tearDown(self) -> None:\n        self._tmp.cleanup()\n\n    def run_script(self, name: str, *args: str):\n        env = {\n            **os.environ,\n            **_OFFLINE_ENV,\n            \"HOME\": str(self.home),\n            \"HERMES_HOME\": str(self.home / \".hermes\"),\n        }\n        return subprocess.run(\n            [sys.executable, \"-B\", str(self.plugin / \"scripts\" / name), *args],\n            cwd=self.home,\n            env=env,\n            capture_output=True,\n            text=True,\n            timeout=60,\n        )\n\n    def test_route_check_runs(self) -> None:\n        result = self.run_script(\"route_check.py\", \"--all\")\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_route_check_routes_a_goal(self) -> None:\n        result = self.run_script(\n            \"route_check.py\", \"write a python function that parses dates\"\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def code_tier_rows(self) -> list[tuple[str, int, int]]:\n        \"\"\"The ``code`` tier's (model, NPU %, context) rows from --all.\"\"\"\n        result = self.run_script(\"route_check.py\", \"--all\")\n        self.assertEqual(result.returncode, 0, result.stderr)\n        rows = []\n        for line in result.stdout.splitlines():\n            cells = line.lstrip(\"* \").split()\n            if len(cells) == 4 and cells[0] == \"code\":\n                rows.append((cells[1], int(cells[2].rstrip(\"%\")),\n                             int(cells[3])))\n        return rows\n\n    def test_code_tier_offers_ornith_1_5_turbo(self) -> None:\n        rows = self.code_tier_rows()\n        self.assertEqual(rows[0][0], \"Qwen/Qwen3.6-35B-A3B\")\n        self.assertEqual(\n            rows[1], (\"ornith-ai/Ornith-1.5-35B-A3B-Turbo\", 54, 262144)\n        )\n\n    def test_route_check_never_reports_ornith_1_0(self) -> None:\n        models = [row[0] for row in self.code_tier_rows()]\n        self.assertNotIn(\"deepreinforce-ai/Ornith-1.0-35B\", models)\n        result = self.run_script(\n            \"route_check.py\", \"--tier\", \"code\", \"--alternatives\",\n            \"fix the failing build\",\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        self.assertNotIn(\"Ornith-1.0-35B\", result.stdout)\n\n    def test_controller_loads_tier_table(self) -> None:\n        # The controller loads the tier table at import, before argparse\n        # runs, so --help exits non-zero if the table cannot be found.\n        result = self.run_script(\"tiiny_ctl.py\", \"--help\")\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_backend_loads_controller(self) -> None:\n        # Import the backend as a package from the copy, with a stub for\n        # the one Hermes module it imports, and report whether it found\n        # the controller.\n        probe = self.home / \"probe.py\"\n        probe.write_text(_IMPORT_PROBE)\n        env = {\n            **os.environ,\n            **_OFFLINE_ENV,\n            \"HOME\": str(self.home),\n            \"HERMES_HOME\": str(self.home / \".hermes\"),\n        }\n        result = subprocess.run(\n            [sys.executable, \"-B\", str(probe), str(self.plugin)],\n            cwd=self.home,\n            env=env,\n            capture_output=True,\n            text=True,\n            timeout=60,\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        self.assertEqual(result.stdout.strip(), \"controller loaded\")\n\n\n_IMPORT_PROBE = '''\nimport importlib.util\nimport sys\nimport types\nfrom pathlib import Path\n\nstub = types.ModuleType(\"agent.delegation_provider\")\nstub.DelegationProvider = type(\"DelegationProvider\", (), {})\nstub.DelegationRouteError = type(\"DelegationRouteError\", (Exception,), {})\nsys.modules[\"agent\"] = types.ModuleType(\"agent\")\nsys.modules[\"agent.delegation_provider\"] = stub\n\nplugin = Path(sys.argv[1])\nspec = importlib.util.spec_from_file_location(\n    \"tiiny_router\",\n    plugin / \"__init__.py\",\n    submodule_search_locations=[str(plugin)],\n)\nmodule = importlib.util.module_from_spec(spec)\nsys.modules[\"tiiny_router\"] = module\nspec.loader.exec_module(module)\nprint(\"controller loaded\" if module.ctl is not None else \"no controller\")\n'''\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":154,"startLine":1,"totalLines":154}},"tool_result_meta":[{"id":"toolu_01Mmoeq8K3tzd6CB1DCCzsAM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
