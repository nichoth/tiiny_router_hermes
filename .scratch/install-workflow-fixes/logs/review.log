troller writes it. When HERMES_HOME is\n+a profile directory the two must agree on where \"the base Hermes home\"\n+is, or the router never sees the plan the controller wrote.\n+\n+Each test copies tiiny-router/ to an arbitrary temporary path, sets\n+HERMES_HOME in a subprocess environment, imports the module, and reports\n+its plan path. The same environment is used for both sides so they face\n+the same HERMES_HOME.\n+\n+Run with: ``python3 -B test/test_plan_path.py``\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import json\n+import os\n+import shutil\n+import subprocess\n+import sys\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+SOURCE = Path(__file__).resolve().parent.parent / \"tiiny-router\"\n+\n+_ROUTER_PROBE = '''\n+import importlib.util\n+import json\n+import os\n+import sys\n+import types\n+from pathlib import Path\n+\n+stub = types.ModuleType(\"agent.delegation_provider\")\n+stub.DelegationProvider = type(\"DelegationProvider\", (), {})\n+stub.DelegationRouteError = type(\n+    \"DelegationRouteError\", (Exception,), {}\n+)\n+sys.modules[\"agent\"] = types.ModuleType(\"agent\")\n+sys.modules[\"agent.delegation_provider\"] = stub\n+\n+plugin = Path(sys.argv[1])\n+spec = importlib.util.spec_from_file_location(\n+    \"tiiny_router\",\n+    plugin / \"__init__.py\",\n+    submodule_search_locations=[str(plugin)],\n+)\n+module = importlib.util.module_from_spec(spec)\n+sys.modules[\"tiiny_router\"] = module\n+spec.loader.exec_module(module)\n+\n+print(json.dumps({\"plan_file\": str(module.PLAN_FILE)}))\n+'''\n+\n+_CTL_PROBE = '''\n+import importlib.util\n+import json\n+import os\n+import sys\n+from pathlib import Path\n+\n+plugin = Path(sys.argv[1])\n+spec = importlib.util.spec_from_file_location(\n+    \"tiiny_ctl\",\n+    plugin / \"scripts\" / \"tiiny_ctl.py\",\n+)\n+module = importlib.util.module_from_spec(spec)\n+spec.loader.exec_module(module)\n+\n+print(json.dumps({\"plan_file\": str(module.PLAN_FILE)}))\n+'''\n+\n+\n+class PlanPath(unittest.TestCase):\n+    def setUp(self) -> None:\n+        self._tmp = tempfile.TemporaryDirectory()\n+        self.tmp = Path(self._tmp.name)\n+        self.plugin = self.tmp / \"plugin\" / \"tiiny-router\"\n+        shutil.copytree(\n+            SOURCE,\n+            self.plugin,\n+            ignore=shutil.ignore_patterns(\"__pycache__\"),\n+        )\n+        self.router_probe = self.tmp / \"router_probe.py\"\n+        self.router_probe.write_text(_ROUTER_PROBE)\n+        self.ctl_probe = self.tmp / \"ctl_probe.py\"\n+        self.ctl_probe.write_text(_CTL_PROBE)\n+\n+    def tearDown(self) -> None:\n+        self._tmp.cleanup()\n+\n+    def _run_probe(\n+        self, probe:Path, hermes_home:str,\n+        extra_env:dict[str, str] | None = None,\n+    ) -> dict:\n+        home = self.tmp / \"fakehome\"\n+        home.mkdir(exist_ok=True)\n+        env = {\n+            \"PYTHONDONTWRITEBYTECODE\": \"1\",\n+            \"HOME\": str(home),\n+            \"HERMES_HOME\": hermes_home,\n+            \"PATH\": os.environ.get(\"PATH\", \"\"),\n+        }\n+        if extra_env:\n+            env.update(extra_env)\n+        result = subprocess.run(\n+            [\n+                sys.executable, \"-B\",\n+                str(probe), str(self.plugin),\n+            ],\n+            cwd=str(home),\n+            env=env,\n+            capture_output=True,\n+            text=True,\n+            timeout=60,\n+        )\n+        if result.returncode != 0:\n+            raise AssertionError(\n+                f\"probe failed:\\n{result.stderr}\"\n+            )\n+        return json.loads(result.stdout)\n+\n+    def test_plain_hermes_home(self) -> None:\n+        \"\"\"HERMES_HOME=<tmp>/home -- both resolve plan under it.\"\"\"\n+        hh = str(self.tmp / \"home\")\n+        router = self._run_probe(self.router_probe, hh)\n+        ctl = self._run_probe(self.ctl_probe, hh)\n+        rp = Path(router[\"plan_file\"])\n+        cp = Path(ctl[\"plan_file\"])\n+        self.assertTrue(\n+            str(rp).startswith(hh),\n+            f\"router plan {rp} not under {hh}\",\n+        )\n+        self.assertEqual(rp, cp)\n+\n+    def test_profile_hermes_home(self) -> None:\n+        \"\"\"HERMES_HOME=.../profiles/work -- both resolve to parent.\"\"\"\n+        base = self.tmp / \"hermes\"\n+        hh = str(base / \"profiles\" / \"work\")\n+        Path(hh).mkdir(parents=True, exist_ok=True)\n+        router = self._run_probe(self.router_probe, hh)\n+        ctl = self._run_probe(self.ctl_probe, hh)\n+        rp = Path(router[\"plan_file\"])\n+        cp = Path(ctl[\"plan_file\"])\n+        self.assertTrue(\n+            str(rp).startswith(str(base)),\n+            f\"router plan {rp} not under {base}\",\n+        )\n+        self.assertFalse(\n+            str(rp).startswith(hh),\n+            f\"router plan {rp} should NOT be under profile {hh}\",\n+        )\n+        self.assertEqual(rp, cp)\n+\n+    def test_tiiny_plan_file_override(self) -> None:\n+        \"\"\"TIINY_PLAN_FILE wins on both sides.\"\"\"\n+        override = str(self.tmp / \"custom-plan.json\")\n+        hh = str(self.tmp / \"home\")\n+        extra = {\"TIINY_PLAN_FILE\": override}\n+        router = self._run_probe(\n+            self.router_probe, hh, extra_env=extra,\n+        )\n+        ctl = self._run_probe(\n+            self.ctl_probe, hh, extra_env=extra,\n+        )\n+        self.assertEqual(router[\"plan_file\"], override)\n+        self.assertEqual(ctl[\"plan_file\"], override)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\ndiff --git a/test/uninstall.test.ts b/test/uninstall.test.ts\nindex 8992920..dcc388a 100644\n--- a/test/uninstall.test.ts\n+++ b/test/uninstall.test.ts\n@@ -77,13 +77,17 @@ test('uninstall with nothing installed exits zero', t => {\n     assert.equal(env.run(['uninstall']).status, 0)\n })\n \n-test('uninstall makes no hermes config set call', t => {\n+test('uninstall makes no hermes config or plugins call', t => {\n     const env = makeEnv()\n     t.after(() => env.cleanup())\n     assert.equal(env.run(['install']).status, 0)\n     const callsBefore = env.hermesCalls().length\n     assert.equal(env.run(['uninstall']).status, 0)\n-    const configCalls = env.hermesCalls().slice(callsBefore)\n-        .filter(argv => argv[0] === 'config')\n-    assert.deepEqual(configCalls, [])\n+    const afterCalls = env.hermesCalls().slice(callsBefore)\n+    const configCalls = afterCalls.filter(argv => argv[0] === 'config')\n+    assert.deepEqual(configCalls, [], 'no hermes config calls')\n+    const pluginsCalls = afterCalls.filter(\n+        argv => argv[0] === 'plugins'\n+    )\n+    assert.deepEqual(pluginsCalls, [], 'no hermes plugins calls')\n })\ndiff --git a/tiiny-router/__init__.py b/tiiny-router/__init__.py\nindex e3e39bd..7e33163 100644\n--- a/tiiny-router/__init__.py\n+++ b/tiiny-router/__init__.py\n@@ -66,7 +66,8 @@ resident.\n The loading half lives in ``scripts/tiiny_ctl.py``, which the manager agent\n drives explicitly: plan the batch, take the cross-agent lock, load what the\n batch needs, delegate, then release. Between those two calls the router and\n-the controller agree on one file — the **plan** (``~/.hermes/tiiny-plan.json``).\n+the controller agree on one file — the **plan** (``tiiny-plan.json`` in the\n+base Hermes home).\n \n The plan is what makes the two halves agree. When the controller has loaded a\n specialist for a batch, the plan records which model it assigned to which\n@@ -164,9 +165,28 @@ _residency_cache: tuple[float, frozenset[str]] | None = None\n #: The plan the lifecycle controller writes. It lives in the BASE Hermes home\n #: on purpose: every profile's manager agent must see the same plan, and the\n #: base home is what they share.\n-PLAN_FILE = Path(\n-    os.environ.get(\"TIINY_PLAN_FILE\", \"~/.hermes/tiiny-plan.json\")\n-).expanduser()\n+\n+\n+def _shared_home() -> Path:\n+    \"\"\"The base Hermes home, even when HERMES_HOME is a profile.\n+\n+    Duplicates the rule in ``scripts/tiiny_ctl.py:_shared_home`` --\n+    a shared module is out of scope for now.\n+    \"\"\"\n+    home = Path(\n+        os.environ.get(\"HERMES_HOME\", \"~/.hermes\")\n+    ).expanduser()\n+    if (home.name != \"profiles\"\n+            and home.parent.name == \"profiles\"):\n+        return home.parent.parent\n+    return home\n+\n+\n+PLAN_FILE = (\n+    Path(os.environ[\"TIINY_PLAN_FILE\"]).expanduser()\n+    if os.environ.get(\"TIINY_PLAN_FILE\")\n+    else _shared_home() / \"tiiny-plan.json\"\n+)\n \n #: Whether the router calls ``ensure`` on every route.  When ``True`` the\n #: router silently loads any model that is not yet resident (idempotent, so\n@@ -268,7 +288,8 @@ def planned_models() -> dict[str, str]:\n     \"\"\"Return the plan's ``goal -> model`` assignments, or an empty mapping.\n \n     The plan is written by ``scripts/tiiny_ctl.py plan`` and lives at\n-    ``~/.hermes/tiiny-plan.json``. A missing, unreadable or malformed plan is\n+    ``tiiny-plan.json`` in the base Hermes home. A missing, unreadable or\n+    malformed plan is\n     not an error: it simply means the lifecycle did not run, and the router\n     falls back to the residency-only rule. Routing must never fail because a\n     sidecar file is wrong.\ndiff --git a/tiiny-router/references/backend.md b/tiiny-router/references/backend.md\nindex e5b495c..219679d 100644\n--- a/tiiny-router/references/backend.md\n+++ b/tiiny-router/references/backend.md\n@@ -16,10 +16,10 @@ resource and a load is a swap that evicts whatever was resident, so the\n loading half of the job lives in `scripts/tiiny_ctl.py` -- a step the manager\n agent takes explicitly. See [lifecycle.md](lifecycle.md).\n \n-The two halves meet at the **plan** (`~/.hermes/tiiny-plan.json`): the\n-controller writes it when it plans a batch, and the router reads it when it\n-routes each subtask. That is how a specialist the controller just loaded\n-becomes the specialist the child actually runs on.\n+The two halves meet at the **plan** (`tiiny-plan.json` in the base Hermes\n+home): the controller writes it when it plans a batch, and the router reads\n+it when it routes each subtask. That is how a specialist the controller just\n+loaded becomes the specialist the child actually runs on.\n \n ## Install\n \ndiff --git a/tiiny-router/scripts/tiiny_ctl.py b/tiiny-router/scripts/tiiny_ctl.py\nindex 2dd677a..723e76b 100644\n--- a/tiiny-router/scripts/tiiny_ctl.py\n+++ b/tiiny-router/scripts/tiiny_ctl.py\n@@ -16,9 +16,10 @@ see:\n \n     plan  ->  reserve  ->  load  ->  delegate  ->  release\n \n-Between ``plan`` and ``load`` the plan file (``~/.hermes/tiiny-plan.json``) is\n-what the two halves share: it records which model was assigned to which goal,\n-so the plugin routes the child to the model this script just loaded.\n+Between ``plan`` and ``load`` the plan file (``tiiny-plan.json`` in the base\n+Hermes home) is what the two halves share: it records which model was assigned\n+to which goal, so the plugin routes the child to the model this script just\n+loaded.\n \n The lock\n --------\n@@ -98,8 +99,9 @@ def _shared_home() -> Path:\n \n     Two readers live in the base home and will not look anywhere else:\n \n-    - the delegation plugin reads the plan from ``~/.hermes/tiiny-plan.json``\n-      on purpose — \"every profile's manager agent must see the same plan\";\n+    - the delegation plugin reads the plan from the base Hermes home\n+      (``_shared_home()`` in ``__init__.py``) -- \"every profile's manager\n+      agent must see the same plan\";\n     - every profile writes the hold to ``~/.hermes/tiiny-hold``, so one\n       agent's record of what it loaded is visible to the next.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XJgV23LNcUQy4vMsmM2e3G","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
