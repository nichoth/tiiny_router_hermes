{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XJgV23LNcUQy4vMsmM2e3G","type":"tool_result","content":"diff --git a/AGENTS.md b/AGENTS.md\nindex 075b56e..3fb34ae 100644\n--- a/AGENTS.md\n+++ b/AGENTS.md\n@@ -15,8 +15,9 @@ The install steps are (the user-facing version is `README.md`):\n    `hermes plugins validate`.\n 2. Add `TIINY_API_KEY` to `~/.hermes/.env` by hand; the installer never\n    touches that file.\n-3. Let the config step add the `tiiny` provider and set\n-   `delegation.backend: tiiny-router` (prompted, or `--configure`).\n+3. Let the config step add the `tiiny` provider, set\n+   `delegation.backend: tiiny-router`, and enable the plugin\n+   (prompted, or `--configure`).\n 4. Run `npx --package hermes-tiiny-router hermesrouter doctor`, then check\n    a goal with\n    `npx --package hermes-tiiny-router hermesrouter route-check \"...\"`, then\ndiff --git a/README.md b/README.md\nindex 15d9d68..3bf5082 100644\n--- a/README.md\n+++ b/README.md\n@@ -213,8 +213,9 @@ when working with profiles.\n \n ### Settings written by the installer\n \n-The config step sets `delegation.backend` to `tiiny-router` and writes the\n-following fields under `providers.tiiny`:\n+The config step sets `delegation.backend` to `tiiny-router`, enables the\n+plugin with `hermes plugins enable tiiny-router`, and writes the following\n+fields under `providers.tiiny`:\n \n | Field | Value |\n | --- | --- |\n@@ -254,7 +255,8 @@ npx hermesrouter doctor\n `doctor` prints a pass, warn or fail line for each check: the installed\n directory is complete, its version matches the package, no installed file\n was edited, `hermes plugins validate` passes, `delegation.backend` selects\n-`tiiny-router`, `python3` is present, and the device answers. It exits\n+`tiiny-router`, the plugin is enabled in `plugins.enabled`, `python3` is\n+present, and the device answers. It exits\n non-zero when any check fails. A device that cannot be reached is a\n warning, not a failure.\n \n@@ -294,14 +296,15 @@ npx hermesrouter uninstall\n \n This removes `$HERMES_HOME/plugins/tiiny-router/`, and only when its\n manifest shows this package installed it. It does not change Hermes\n-config; it prints the `hermes config set` command that unselects the\n-backend.\n+config; it prints the commands that unselect the backend and disable the\n+plugin.\n \n-To restore ordinary delegation, run this in the same Hermes configuration\n+To restore ordinary delegation, run these in the same Hermes configuration\n before starting another session:\n \n ```bash\n hermes config set delegation.backend default\n+hermes plugins disable tiiny-router\n ```\n \n Uninstall does not restore previous settings or remove `providers.tiiny`.\ndiff --git a/package.json b/package.json\nindex b963c51..84c3091 100644\n--- a/package.json\n+++ b/package.json\n@@ -20,7 +20,7 @@\n   },\n   \"scripts\": {\n     \"build\": \"tsc\",\n-    \"test\": \"npm run build && node --test test/*.test.ts && python3 -B test/test_installed_tree.py && python3 -B test/test_register.py\",\n+    \"test\": \"npm run build && node --test test/*.test.ts && python3 -B test/test_installed_tree.py && python3 -B test/test_register.py && python3 -B test/test_plan_path.py\",\n     \"prepack\": \"npm run build\",\n     \"version\": \"node scripts/stamp-version.ts && git add tiiny-router/plugin.yaml tiiny-router/SKILL.md\",\n     \"toc\": \"markdown-toc --maxdepth 3 -i README.md\"\ndiff --git a/src/cli.ts b/src/cli.ts\nindex 3564c2e..061268a 100644\n--- a/src/cli.ts\n+++ b/src/cli.ts\n@@ -5,7 +5,7 @@ import { type InstallOptions, install } from './install.js'\n import { SCRIPTS, runInstalledScript } from './passthrough.js'\n import { uninstall } from './uninstall.js'\n \n-const USAGE = `Usage: hermes-tiiny-router <command>\n+const USAGE = `Usage: hermesrouter <command>\n \n Commands:\n   install [--force] [--configure | --no-configure]\n@@ -71,6 +71,6 @@ function main (argv:string[]):number {\n try {\n     process.exitCode = main(process.argv.slice(2))\n } catch (err) {\n-    process.stderr.write(`hermes-tiiny-router: ${(err as Error).message}\\n`)\n+    process.stderr.write(`hermesrouter: ${(err as Error).message}\\n`)\n     process.exitCode = 1\n }\ndiff --git a/src/config.ts b/src/config.ts\nindex 1cc928b..93ddb88 100644\n--- a/src/config.ts\n+++ b/src/config.ts\n@@ -33,6 +33,13 @@ const PROVIDER = 'providers.tiiny'\n  * Every setting the config step makes, in order. Model ids contain dots,\n  * so the `models` map is set as one JSON value (valid YAML flow syntax)\n  * rather than through dotted keys.\n+ *\n+ * Value forms rely on Hermes coercion (`_coerce_config_set_value` in\n+ * `hermes_cli/config.py`): `false`/`true` become booleans, bare digits\n+ * become integers, and a JSON object becomes a map, for every key whose\n+ * `DEFAULT_CONFIG` default is not a string. None of the\n+ * `providers.tiiny` keys has a string default.\n+ * Pinned by guard tests in `test/config.test.ts`.\n  */\n export const SETTINGS:ConfigSetting[] = [\n     [`${PROVIDER}.name`, 'tiiny'],\n@@ -55,8 +62,11 @@ function shellQuote (s:string):string {\n \n /** The settings as shell commands a user can run by hand. */\n export function configCommands ():string[] {\n-    return SETTINGS.map(([key, value]) =>\n-        `hermes config set ${shellQuote(key)} ${shellQuote(value)}`)\n+    return [\n+        ...SETTINGS.map(([key, value]) =>\n+            `hermes config set ${shellQuote(key)} ${shellQuote(value)}`),\n+        `hermes plugins enable ${PLUGIN_NAME}`,\n+    ]\n }\n \n /** Apply every setting. Returns the first non-zero hermes exit code. */\n@@ -71,6 +81,17 @@ function applyConfig ():number {\n             return status\n         }\n     }\n+    const enableStatus = runHermes(\n+        ['plugins', 'enable', PLUGIN_NAME]\n+    )\n+    if (enableStatus !== 0) {\n+        console.error(\n+            '`hermes plugins enable ' + PLUGIN_NAME +\n+            '` failed (exit ' + enableStatus + '); ' +\n+            'Hermes config may be partly updated'\n+        )\n+        return enableStatus\n+    }\n     console.log(\n         'Selected the tiiny-router delegation backend. ' +\n         'It takes effect from the next Hermes session.'\ndiff --git a/src/doctor.ts b/src/doctor.ts\nindex b3a9be7..efa4fb8 100644\n--- a/src/doctor.ts\n+++ b/src/doctor.ts\n@@ -131,6 +131,40 @@ function checks (dir:string):Check[] {\n                 )\n             },\n         },\n+        {\n+            name: 'plugin enabled',\n+            run: () => {\n+                const enabled = hermesOutput(\n+                    ['config', 'get', 'plugins.enabled']\n+                )\n+                const list = enabled.stdout.trim()\n+                    .replace(/^\\[|]$/g, '')\n+                    .split(/[,\\n]/)\n+                    .map(s => s.trim().replace(/^['\"]|['\"]$/g, ''))\n+                    .filter(Boolean)\n+                if (!list.includes(PLUGIN_NAME)) {\n+                    return fail(\n+                        'not in plugins.enabled; run ' +\n+                        `hermes plugins enable ${PLUGIN_NAME}`\n+                    )\n+                }\n+                const disabled = hermesOutput(\n+                    ['config', 'get', 'plugins.disabled']\n+                )\n+                const dList = disabled.stdout.trim()\n+                    .replace(/^\\[|]$/g, '')\n+                    .split(/[,\\n]/)\n+                    .map(s => s.trim().replace(/^['\"]|['\"]$/g, ''))\n+                    .filter(Boolean)\n+                if (dList.includes(PLUGIN_NAME)) {\n+                    return fail(\n+                        'listed in plugins.disabled; run ' +\n+                        `hermes plugins enable ${PLUGIN_NAME}`\n+                    )\n+                }\n+                return pass('enabled')\n+            },\n+        },\n         {\n             name: 'python3',\n             run: () => {\ndiff --git a/src/passthrough.ts b/src/