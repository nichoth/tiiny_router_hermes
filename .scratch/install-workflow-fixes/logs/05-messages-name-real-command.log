  return r.status\n}\n","structuredPatch":[{"oldStart":16,"oldLines":7,"newStart":16,"newLines":7,"lines":["     const file = path.join(pluginDir(), 'scripts', script)","     if (!existsSync(file)) {","         console.error(","-            `${file} not found; run \\`hermes-tiiny-router install\\` first`","+            `${file} not found; run \\`hermesrouter install\\` first`","         )","         return 1","     }"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01KoKwjzgmxtAhgcMBXCFTw9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
