        readFileSync(config, 'utf8'),\n        'delegation:\\n  backend: default\\n'\n    )\n    assert.equal(\n        readFileSync(secrets, 'utf8'),\n        'TIINY_API_KEY=not-a-real-key\\n'\n    )\n    assert.deepEqual(\n        [statSync(config).mtimeMs, statSync(secrets).mtimeMs],\n        before\n    )\n})\n# Hermes Tiiny Router\n\nAn npm-distributed add-on for the Hermes agent harness that runs delegated\nsub-agents on a Tiiny appliance, routing each subtask to the model that fits\nits shape.\n\n## Language\n\n### Distribution\n\n**Package**:\nThe npm artifact that carries the routing backend, the controller and the\nskill, plus the installer that places them into a Hermes home.\n_Avoid_: plugin (for this meaning), module, bundle\n\n**Routing backend**:\nThe Hermes delegation provider that picks a model for each delegated task.\n_Avoid_: plugin, router plugin, delegation plugin\n\n**Controller**:\nThe command-line tool that plans a batch, locks the device, loads and\nevicts models, and releases the device.\n_Avoid_: lifecycle script, swap script, ctl\n\n**Skill**:\nThe instructions that tell a manager agent how to drive the controller and\ndelegate through the routing backend.\n_Avoid_: playbook, guide\n0001-npm-installs-a-single-hermes-user-plugin.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QNmh4NGnRuoNpvaVp1AvWY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XeS88QAG3aQJGETpCpHM9J","type":"tool_result","content":"src:\ncli.ts\nhermes.ts\ninstall.ts\nmanifest.ts\npackage.ts\n\ntest:\nharness.ts\ninstall.test.ts\ntest_installed_tree.py\ntest_register.py\n#!/usr/bin/env node\nimport { install } from './install.js'\n\nconst USAGE = `Usage: hermes-tiiny-router <command>\n\nCommands:\n  install    Copy the plugin into $HERMES_HOME/plugins/tiiny-router/\n`\n\nfunction main (argv:string[]):number {\n    const [command] = argv\n    switch (command) {\n        case 'install':\n            return install()\n        case undefined:\n        case '-h':\n        case '--help':\n            process.stdout.write(USAGE)\n            return command ? 0 : 1\n        default:\n            process.stderr.write(`Unknown command: ${command}\\n\\n${USAGE}`)\n            return 1\n    }\n}\n\ntry {\n    process.exitCode = main(process.argv.slice(2))\n} catch (err) {\n    process.stderr.write(`hermes-tiiny-router: ${(err as Error).message}\\n`)\n    process.exitCode = 1\n}\n/**\n * Run the `hermes` command found on PATH. Its output goes straight to the\n * user's terminal.\n */\nimport { spawnSync } from 'node:child_process'\n\n/** Run `hermes ...args` and return its exit code. */\nexport function runHermes (args:string[]):number {\n    const r = spawnSync('hermes', args, { stdio: 'inherit' })\n    if (r.error) {\n        const code = (r.error as NodeJS.ErrnoException).code\n        if (code === 'ENOENT') {\n            throw new Error('`hermes` was not found on PATH')\n        }\n        throw r.error\n    }\n    return r.status ?? 1\n}\n/**\n * `install`: copy the plugin tree into `$HERMES_HOME/plugins/tiiny-router/`,\n * write the manifest, then have Hermes validate it.\n */\nimport { copyFileSync, mkdirSync } from 'node:fs'\nimport path from 'node:path'\nimport { runHermes } from './hermes.js'\nimport { buildManifest, listTree, writeManifest } from './manifest.js'\nimport { SOURCE_TREE, packageVersion, pluginDir } from './package.js'\n\nexport function install ():number {\n    const target = pluginDir()\n    const files = listTree(SOURCE_TREE)\n    for (const rel of files) {\n        const dest = path.join(target, rel)\n        mkdirSync(path.dirname(dest), { recursive: true })\n        copyFileSync(path.join(SOURCE_TREE, rel), dest)\n    }\n    writeManifest(target, buildManifest(target, files, packageVersion()))\n    console.log(`Installed ${files.length} files into ${target}`)\n\n    const status = runHermes(['plugins', 'validate', target])\n    if (status !== 0) {\n        console.error(\n            `\\`hermes plugins validate\\` rejected ${target} ` +\n            `(exit ${status})`\n        )\n        return status\n    }\n    return 0\n}\n/**\n * The install manifest: a file inside the installed directory that marks\n * it as installed by this package and records the hash of every file the\n * install wrote.\n */\nimport { createHash } from 'node:crypto'\nimport { readFileSync, readdirSync, writeFileSync } from 'node:fs'\nimport path from 'node:path'\nimport { PACKAGE_NAME } from './package.js'\n\nexport const MANIFEST_FILE = '.hermes-tiiny-router-manifest.json'\n\nexport interface Manifest {\n    package:string;\n    version:string;\n    /** Relative path (with `/` separators) -> sha256 hex digest. */\n    files:Record<string, string>;\n}\n\n/** Directory names that are never copied or recorded. */\nconst SKIP = new Set(['__pycache__'])\n\n/** Relative paths of every file under `dir`, `/`-separated, sorted. */\nexport function listTree (dir:string):string[] {\n    const out:string[] = []\n    const walk = (rel:string) => {\n        const entries = readdirSync(path.join(dir, rel), {\n            withFileTypes: true,\n        })\n        for (const entry of entries) {\n            if (SKIP.has(entry.name)) continue\n            const r = rel ? `${rel}/${entry.name}` : entry.name\n            if (entry.isDirectory()) walk(r)\n            else if (entry.isFile()) out.push(r)\n        }\n    }\n    walk('')\n    return out.sort()\n}\n\nexport function hashFile (file:string):string {\n    return createHash('sha256').update(readFileSync(file)).digest('hex')\n}\n\nexport function buildManifest (\n    dir:string,\n    files:string[],\n    version:string\n):Manifest {\n    const hashes:Record<string, string> = {}\n    for (const rel of files) hashes[rel] = hashFile(path.join(dir, rel))\n    return { package: PACKAGE_NAME, version, files: hashes }\n}\n\nexport function writeManifest (dir:string, manifest:Manifest):void {\n    writeFileSync(\n        path.join(dir, MANIFEST_FILE),\n        JSON.stringify(manifest, null, 2) + '\\n'\n    )\n}\n/**\n * Facts about this package: where its files are and which version it is.\n * Everything is found relative to this file, which is compiled into\n * `dist/` at the package root.\n */\nimport { readFileSync } from 'node:fs'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nexport const PACKAGE_NAME = 'hermes-tiiny-router'\nexport const PLUGIN_NAME = 'tiiny-router'\n\nconst PACKAGE_ROOT = path.resolve(\n    path.dirname(fileURLToPath(import.meta.url)),\n    '..'\n)\n\n/** The plugin tree, laid out exactly as it is installed. */\nexport const SOURCE_TREE = path.join(PACKAGE_ROOT, PLUGIN_NAME)\n\nexport function packageVersion ():string {\n    const pkg = JSON.parse(\n        readFileSync(path.join(PACKAGE_ROOT, 'package.json'), 'utf8')\n    ) as { version:string }\n    return pkg.version\n}\n\nexport function hermesHome (env:NodeJS.ProcessEnv = process.env):string {\n    if (env.HERMES_HOME) return path.resolve(env.HERMES_HOME)\n    const home = env.HOME\n    if (!home) throw new Error('HOME is not set; set HERMES_HOME instead')\n    return path.join(home, '.hermes')\n}\n\nexport function pluginDir (env:NodeJS.ProcessEnv = process.env):string {\n    return path.join(hermesHome(env), 'plugins', PLUGIN_NAME)\n}\n/**\n * Seam 1 harness: run the package's command as a subprocess against a\n * temporary HERMES_HOME, with a fake `hermes` executable first on PATH.\n *\n * The fake `hermes` appends one JSON line per call (its argv) to a log\n * file, and exits with the code in FAKE_HERMES_EXIT (default 0).\n */\nimport { spawnSync } from 'node:child_process'\nimport {\n    mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync,\n    rmSync, readdirSync, statSync, chmodSync,\n} from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nexport const REPO = path.resolve(HERE, '..')\nexport const CLI = path.join(REPO, 'dist', 'cli.js')\nexport const SOURCE_TREE = path.join(REPO, 'tiiny-router')\n\nconst FAKE_HERMES = `#!/bin/sh\nnode -e 'require(\"fs\").appendFileSync(process.env.FAKE_HERMES_LOG,\n  JSON.stringify(process.argv.slice(1)) + \"\\\\n\")' -- \"$@\"\nexit \"\\${FAKE_HERMES_EXIT:-0}\"\n`\n\nexport interface RunResult {\n    status:number|null;\n    stdout:string;\n    stderr:string;\n}\n\nexport interface Env {\n    root:string;\n    hermesHome:string;\n    home:string;\n    /** Run the CLI with the given args. */\n    run(args:string[], opts?:{ hermesFails?:boolean }):RunResult;\n    /** argv of every call the fake `hermes` received, in order. */\n    hermesCalls():string[][];\n    cleanup():void;\n}\n\nexport function makeEnv (opts:{ hermesHome?:string } = {}):Env {\n    const root = mkdtempSync(path.join(tmpdir(), 'htr-test-'))\n    const home = path.join(root, 'home')\n    const bin = path.join(root, 'bin')\n    const log = path.join(root, 'hermes-calls.jsonl')\n    mkdirSync(home)\n    mkdirSync(bin)\n    const fake = path.join(bin, 'hermes')\n    writeFileSync(fake, FAKE_HERMES)\n    chmodSync(fake, 0o755)\n\n    const hermesHome = opts.hermesHome ?\n        path.join(root, opts.hermesHome) :\n        path.join(home, '.hermes')\n\n    return {\n        root,\n        hermesHome,\n        home,\n        run (args, runOpts = {}) {\n            const env:NodeJS.ProcessEnv = {\n                ...process.env,\n                HOME: home,\n                PATH: `${bin}${path.delimiter}${process.env.PATH ?? ''}`,\n                FAKE_HERMES_LOG: log,\n                FAKE_HERMES_EXIT: runOpts.hermesFails ? '1' : '0',\n            }\n            delete env.HERMES_HOME\n            if (opts.hermesHome) env.HERMES_HOME = hermesHome\n            const r = spawnSync(process.execPath, [CLI, ...args], {\n                env,\n                encoding: 'utf8',\n                stdio: ['ignore', 'pipe', 'pipe'],\n            })\n            return { status: r.status, stdout: r.stdout, stderr: r.stderr }\n        },\n        hermesCalls () {\n            if (!existsSync(log)) return []\n            return readFileSync(log, 'utf8')\n                .split('\\n')\n                .filter(Boolean)\n                .map(line => JSON.parse(line) as string[])\n        },\n        cleanup () {\n            rmSync(root, { recursive: true, force: true })\n        },\n    }\n}\n\n/** Relative paths of every regular file under `dir`, sorted. */\nexport function listFiles (dir:string):string[] {\n    const out:string[] = []\n    const walk = (rel:string) => {\n        for (const name of readdirSync(path.join(dir, rel))) {\n            if (name === '__pycache__') continue\n            const r = rel ? path.join(rel, name) : name\n            if (statSync(path.join(dir, r)).isDirectory()) walk(r)\n            else out.push(r)\n        }\n    }\n    walk('')\n    return out.sort()\n}\ntest/install.test.ts\n{\n  \"name\": \"hermes-tiiny-router\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Install Tiiny model routing into the Hermes agent harness\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"hermes-tiiny-router\": \"dist/cli.js\"\n  },\n  \"files\": [\n    \"dist\",\n    \"tiiny-router\",\n    \"!**/__pycache__\"\n  ],\n  \"os\": [\n    \"darwin\",\n    \"linux\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"test\": \"npm run build && node --test test/*.test.ts && python3 -B test/test_installed_tree.py\",\n    \"prepack\": \"npm run build\"\n  },\n  \"license\": \"MIT\",\n  \"devDependencies\": {\n    \"@substrate-system/redeye\": \"^0.1.8\",\n    \"@types/node\": \"^26.6.6\",\n    \"typescript\": \"^7.0.2\"\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"1a1b2896-8ca7-424e-b304-b2875e3b6368","uuid":"fe6658cc-064f-44be-895a-4b4dfac8607e","timestamp":"2026-11-21T05:46:45.426Z","tool_use_result":{"stdout":"src:\ncli.ts\nhermes.ts\ninstall.ts\nmanifest.ts\npackage.ts\n\ntest:\nharness.ts\ninstall.test.ts\ntest_installed_tree.py\ntest_register.py\n#!/usr/bin/env node\nimport { install } from './install.js'\n\nconst USAGE = `Usage: hermes-tiiny-router <command>\n\nCommands:\n  install    Copy the plugin into $HERMES_HOME/plugins/tiiny-router/\n`\n\nfunction main (argv:string[]):number {\n    const [command] = argv\n    switch (command) {\n        case 'install':\n            return install()\n        case undefined:\n        case '-h':\n        case '--help':\n            process.stdout.write(USAGE)\n            return command ? 0 : 1\n        default:\n            process.stderr.write(`Unknown command: ${command}\\n\\n${USAGE}`)\n            return 1\n    }\n}\n\ntry {\n    process.exitCode = main(process.argv.slice(2))\n} catch (err) {\n    process.stderr.write(`hermes-tiiny-router: ${(err as Error).message}\\n`)\n    process.exitCode = 1\n}\n/**\n * Run the `hermes` command found on PATH. Its output goes straight to the\n * user's terminal.\n */\nimport { spawnSync } from 'node:child_process'\n\n/** Run `hermes ...args` and return its exit code. */\nexport function runHermes (args:string[]):number {\n    const r = spawnSync('hermes', args, { stdio: 'inherit' })\n    if (r.error) {\n        const code = (r.error as NodeJS.ErrnoException).code\n        if (code === 'ENOENT') {\n            throw new Error('`hermes` was not found on PATH')\n        }\n        throw r.error\n    }\n    return r.status ?? 1\n}\n/**\n * `install`: copy the plugin tree into `$HERMES_HOME/plugins/tiiny-router/`,\n * write the manifest, then have Hermes validate it.\n */\nimport { copyFileSync, mkdirSync } from 'node:fs'\nimport path from 'node:path'\nimport { runHermes } from './hermes.js'\nimport { buildManifest, listTree, writeManifest } from './manifest.js'\nimport { SOURCE_TREE, packageVersion, pluginDir } from './package.js'\n\nexport function install ():number {\n    const target = pluginDir()\n    const files = listTree(SOURCE_TREE)\n    for (const rel of files) {\n        const dest = path.join(target, rel)\n        mkdirSync(path.dirname(dest), { recursive: true })\n        copyFileSync(path.join(SOURCE_TREE, rel), dest)\n    }\n    writeManifest(target, buildManifest(target, files, packageVersion()))\n    console.log(`Installed ${files.length} files into ${target}`)\n\n    const status = runHermes(['plugins', 'validate', target])\n    if (status !== 0) {\n        console.error(\n            `\\`hermes plugins validate\\` rejected ${target} ` +\n            `(exit ${status})`\n        )\n        return status\n    }\n    return 0\n}\n/**\n * The install manifest: a file inside the installed directory that marks\n * it as installed by this package and records the hash of every file the\n * install wrote.\n */\nimport { createHash } from 'node:crypto'\nimport { readFileSync, readdirSync, writeFileSync } from 'node:fs'\nimport path from 'node:path'\nimport { PACKAGE_NAME } from './package.js'\n\nexport const MANIFEST_FILE = '.hermes-tiiny-router-manifest.json'\n\nexport interface Manifest {\n    package:string;\n    version:string;\n    /** Relative path (with `/` separators) -> sha256 hex digest. */\n    files:Record<string, string>;\n}\n\n/** Directory names that are never copied or recorded. */\nconst SKIP = new Set(['__pycache__'])\n\n/** Relative paths of every file under `dir`, `/`-separated, sorted. */\nexport function listTree (dir:string):string[] {\n    const out:string[] = []\n    const walk = (rel:string) => {\n        const entries = readdirSync(path.join(dir, rel), {\n            withFileTypes: true,\n        })\n        for (const entry of entries) {\n            if (SKIP.has(entry.name)) continue\n            const r = rel ? `${rel}/${entry.name}` : entry.name\n            if (entry.isDirectory()) walk(r)\n            else if (entry.isFile()) out.push(r)\n        }\n    }\n    walk('')\n    return out.sort()\n}\n\nexport function hashFile (file:string):string {\n    return createHash('sha256').update(readFileSync(file)).digest('hex')\n}\n\nexport function buildManifest (\n    dir:string,\n    files:string[],\n    version:string\n):Manifest {\n    const hashes:Record<string, string> = {}\n    for (const rel of files) hashes[rel] = hashFile(path.join(dir, rel))\n    return { package: PACKAGE_NAME, version, files: hashes }\n}\n\nexport function writeManifest (dir:string, manifest:Manifest):void {\n    writeFileSync(\n        path.join(dir, MANIFEST_FILE),\n        JSON.stringify(manifest, null, 2) + '\\n'\n    )\n}\n/**\n * Facts about this package: where its files are and which version it is.\n * Everything is found relative to this file, which is compiled into\n * `dist/` at the package root.\n */\nimport { readFileSync } from 'node:fs'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nexport const PACKAGE_NAME = 'hermes-tiiny-router'\nexport const PLUGIN_NAME = 'tiiny-router'\n\nconst PACKAGE_ROOT = path.resolve(\n    path.dirname(fileURLToPath(import.meta.url)),\n    '..'\n)\n\n/** The plugin tree, laid out exactly as it is installed. */\nexport const SOURCE_TREE = path.join(PACKAGE_ROOT, PLUGIN_NAME)\n\nexport function packageVersion ():string {\n    const pkg = JSON.parse(\n        readFileSync(path.join(PACKAGE_ROOT, 'package.json'), 'utf8')\n    ) as { version:string }\n    return pkg.version\n}\n\nexport function hermesHome (env:NodeJS.ProcessEnv = process.env):string {\n    if (env.HERMES_HOME) return path.resolve(env.HERMES_HOME)\n    const home = env.HOME\n    if (!home) throw new Error('HOME is not set; set HERMES_HOME instead')\n    return path.join(home, '.hermes')\n}\n\nexport function pluginDir (env:NodeJS.ProcessEnv = process.env):string {\n    return path.join(hermesHome(env), 'plugins', PLUGIN_NAME)\n}\n/**\n * Seam 1 harness: run the package's command as a subprocess against a\n * temporary HERMES_HOME, with a fake `hermes` executable first on PATH.\n *\n * The fake `hermes` appends one JSON line per call (its argv) to a log\n * file, and exits with the code in FAKE_HERMES_EXIT (default 0).\n */\nimport { spawnSync } from 'node:child_process'\nimport {\n    mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync,\n    rmSync, readdirSync, statSync, chmodSync,\n} from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport path from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nconst HERE = path.dirname(fileURLToPath(import.meta.url))\nexport const REPO = path.resolve(HERE, '..')\nexport const CLI = path.join(REPO, 'dist', 'cli.js')\nexport const SOURCE_TREE = path.join(REPO, 'tiiny-router')\n\nconst FAKE_HERMES = `#!/bin/sh\nnode -e 'require(\"fs\").appendFileSync(process.env.FAKE_HERMES_LOG,\n  JSON.stringify(process.argv.slice(1)) + \"\\\\n\")' -- \"$@\"\nexit \"\\${FAKE_HERMES_EXIT:-0}\"\n`\n\nexport interface RunResult {\n    status:number|null;\n    stdout:string;\n    stderr:string;\n}\n\nexport interface Env {\n    root:string;\n    hermesHome:string;\n    home:string;\n    /** Run the CLI with the given args. */\n    run(args:string[], opts?:{ hermesFails?:boolean }):RunResult;\n    /** argv of every call the fake `hermes` received, in order. */\n    hermesCalls():string[][];\n    cleanup():void;\n}\n\nexport function makeEnv (opts:{ hermesHome?:string } = {}):Env {\n    const root = mkdtempSync(path.join(tmpdir(), 'htr-test-'))\n    const home = path.join(root, 'home')\n    const bin = path.join(root, 'bin')\n    const log = path.join(root, 'hermes-calls.jsonl')\n    mkdirSync(home)\n    mkdirSync(bin)\n    const fake = path.join(bin, 'hermes')\n    writeFileSync(fake, FAKE_HERMES)\n    chmodSync(fake, 0o755)\n\n    const hermesHome = opts.hermesHome ?\n        path.join(root, opts.hermesHome) :\n        path.join(home, '.hermes')\n\n    return {\n        root,\n        hermesHome,\n        home,\n        run (args, runOpts = {}) {\n            const env:NodeJS.ProcessEnv = {\n                ...process.env,\n                HOME: home,\n                PATH: `${bin}${path.delimiter}${process.env.PATH ?? ''}`,\n                FAKE_HERMES_LOG: log,\n                FAKE_HERMES_EXIT: runOpts.hermesFails ? '1' : '0',\n            }\n            delete env.HERMES_HOME\n            if (opts.hermesHome) env.HERMES_HOME = hermesHome\n            const r = spawnSync(process.execPath, [CLI, ...args], {\n                env,\n                encoding: 'utf8',\n                stdio: ['ignore', 'pipe', 'pipe'],\n            })\n            return { status: r.status, stdout: r.stdout, stderr: r.stderr }\n        },\n        hermesCalls () {\n            if (!existsSync(log)) return []\n            return readFileSync(log, 'utf8')\n                .split('\\n')\n                .filter(Boolean)\n                .map(line => JSON.parse(line) as string[])\n        },\n        cleanup () {\n            rmSync(root, { recursive: true, force: true })\n        },\n    }\n}\n\n/** Relative paths of every regular file under `dir`, sorted. */\nexport function listFiles (dir:string):string[] {\n    const out:string[] = []\n    const walk = (rel:string) => {\n        for (const name of readdirSync(path.join(dir, rel))) {\n            if (name === '__pycache__') continue\n            const r = rel ? path.join(rel, name) : name\n            if (statSync(path.join(dir, r)).isDirectory()) walk(r)\n            else out.push(r)\n        }\n    }\n    walk('')\n    return out.sort()\n}\ntest/install.test.ts\n{\n  \"name\": \"hermes-tiiny-router\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Install Tiiny model routing into the Hermes agent harness\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"hermes-tiiny-router\": \"dist/cli.js\"\n  },\n  \"files\": [\n    \"dist\",\n    \"tiiny-router\",\n    \"!**/__pycache__\"\n  ],\n  \"os\": [\n    \"darwin\",\n    \"linux\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"test\": \"npm run build && node --test test/*.test.ts && python3 -B test/test_installed_tree.py\",\n    \"prepack\": \"npm run build\"\n  },\n  \"license\": \"MIT\",\n  \"devDependencies\": {\n    \"@substrate-system/redeye\": \"^0.1.8\",\n    \"@types/node\": \"^26.6.6\",\n    \"typescript\": \"^7.0.2\"\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XeS88QAG3aQJGETpCpHM9J","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
