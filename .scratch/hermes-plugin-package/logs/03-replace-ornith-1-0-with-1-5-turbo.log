{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VTCeZUTSYFNWS1mz1AknaD","type":"tool_result","content":"\"\"\"The plugin source tree works from wherever it is copied.\n\nThe installer copies ``tiiny-router/`` as one tree into\n``$HERMES_HOME/plugins/tiiny-router/``. These tests copy it to an arbitrary\ntemporary path and exercise it there, so any lookup that depends on the\nrepo layout (or on some other fixed path) fails here.\n\nRun with: ``python3 -B test/test_installed_tree.py``\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nSOURCE = Path(__file__).resolve().parent.parent / \"tiiny-router\"\n\n_OFFLINE_ENV = {\"PYTHONDONTWRITEBYTECODE\": \"1\"}\n\n\nclass CopiedTree(unittest.TestCase):\n    def setUp(self) -> None:\n        self._tmp = tempfile.TemporaryDirectory()\n        tmp = Path(self._tmp.name)\n        self.home = tmp / \"home\"\n        self.home.mkdir()\n        self.plugin = tmp / \"somewhere\" / \"else\" / \"tiiny-router\"\n        shutil.copytree(\n            SOURCE,\n            self.plugin,\n            ignore=shutil.ignore_patterns(\"__pycache__\"),\n        )\n\n    def tearDown(self) -> None:\n        self._tmp.cleanup()\n\n    def run_script(self, name: str, *args: str):\n        env = {\n            **os.environ,\n            **_OFFLINE_ENV,\n            \"HOME\": str(self.home),\n            \"HERMES_HOME\": str(self.home / \".hermes\"),\n        }\n        return subprocess.run(\n            [sys.executable, \"-B\", str(self.plugin / \"scripts\" / name), *args],\n            cwd=self.home,\n            env=env,\n            capture_output=True,\n            text=True,\n            timeout=60,\n        )\n\n    def test_route_check_runs(self) -> None:\n        result = self.run_script(\"route_check.py\", \"--all\")\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_route_check_routes_a_goal(self) -> None:\n        result = self.run_script(\n            \"route_check.py\", \"write a python function that parses dates\"\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_controller_loads_tier_table(self) -> None:\n        # The controller loads the tier table at import, before argparse\n        # runs, so --help exits non-zero if the table cannot be found.\n        result = self.run_script(\"tiiny_ctl.py\", \"--help\")\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_backend_loads_controller(self) -> None:\n        # Import the backend as a package from the copy, with a stub for\n        # the one Hermes module it imports, and report whether it found\n        # the controller.\n        probe = self.home / \"probe.py\"\n        probe.write_text(_IMPORT_PROBE)\n        env = {\n            **os.environ,\n            **_OFFLINE_ENV,\n            \"HOME\": str(self.home),\n            \"HERMES_HOME\": str(self.home / \".hermes\"),\n        }\n        result = subprocess.run(\n            [sys.executable, \"-B\", str(probe), str(self.plugin)],\n            cwd=self.home,\n            env=env,\n            capture_output=True,\n            text=True,\n            timeout=60,\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        self.assertEqual(result.stdout.strip(), \"controller loaded\")\n\n\n_IMPORT_PROBE = '''\nimport importlib.util\nimport sys\nimport types\nfrom pathlib import Path\n\nstub = types.ModuleType(\"agent.delegation_provider\")\nstub.DelegationProvider = type(\"DelegationProvider\", (), {})\nstub.DelegationRouteError = type(\"DelegationRouteError\", (Exception,), {})\nsys.modules[\"agent\"] = types.ModuleType(\"agent\")\nsys.modules[\"agent.delegation_provider\"] = stub\n\nplugin = Path(sys.argv[1])\nspec = importlib.util.spec_from_file_location(\n    \"tiiny_router\",\n    plugin / \"__init__.py\",\n    submodule_search_locations=[str(plugin)],\n)\nmodule = importlib.util.module_from_spec(spec)\nsys.modules[\"tiiny_router\"] = module\nspec.loader.exec_module(module)\nprint(\"controller loaded\" if module.ctl is not None else \"no controller\")\n'''\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n#!/usr/bin/env python3\n\"\"\"route_check.py — show which Tiiny model a task goal would be routed to.\n\nA read-only companion to the routing backend. It applies the same tier table\nand the same shape detection, then prints the tier, the model, that model's\nNPU share and context window, and what the model's reasoning mode would be —\nso a routing decision can be checked without spawning a child agent.\n\nThe tier table comes from the plugin's ``tiers.py`` and the reasoning control\nfrom its ``thinking.py``: the same files the routing plugin reads, so this\nscript and the backend cannot drift apart. Both sit in the plugin directory,\none level above this script, and are found relative to this file only.\n\nUsage:\n    python3 route_check.py \"index every file under the vault and classify each\"\n    python3 route_check.py --tier code\n    python3 route_check.py --all          # every tier, with its budget\n    python3 route_check.py --image \"a photorealistic portrait\"\n    python3 route_check.py --thinking off \"summarise the meeting notes\"\n    python3 route_check.py --thinking on  \"solve this novel reasoning problem\"\n\nExit codes:\n    0  a route was found\n    1  the tier was not recognised\n    2  the usage was wrong\n\nThe script changes nothing on the device. It makes read-only calls: one to\nthe device's resident model list, and — only when a thinking mode is asked\nfor — one to the device's model catalogue, to read what that model can do\nwith reasoning.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport importlib.util\nimport os\nimport sys\nfrom pathlib import Path\n\n#: The plugin directory: this script lives in its ``scripts/`` folder.\n_PLUGIN_DIR = Path(__file__).resolve().parent.parent\n\n\ndef _load(name: str, filename: str):\n    \"\"\"Load a shared plugin module by path from the plugin directory.\"\"\"\n    path = _PLUGIN_DIR / filename\n    spec = importlib.util.spec_from_file_location(name, path)\n    if not path.exists() or spec is None or spec.loader is None:\n        raise SystemExit(\n            f\"could not find {filename}. It ships in the plugin directory: \"\n            f\"{path}\"\n        )\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ntiers = _load(\"tiiny_tiers\", \"tiers.py\")\nthinking = _load(\"tiiny_thinking\", \"thinking.py\")\n\nTIER_CHOICES = tiers.TIER_CHOICES\nTIER_MODEL = tiers.TIER_MODEL\nVALID_TIERS = tiers.VALID_TIERS\n\n\ndef detect_tier(goal: str) -> str:\n    \"\"\"Return the task tier for a goal, or 'general' when unrecognised.\"\"\"\n    return tiers.detect_tier(goal)\n\n\ndef resident_models() -> set[str] | None:\n    \"\"\"Models currently resident, read from the device CLI. None if unavailable.\"\"\"\n    import shutil\n    import subprocess\n\n    tiiny = shutil.which(\"tiiny\") or os.path.expanduser(\"~/.local/tiiny/bin/tiiny\")\n    if not os.path.exists(tiiny):\n        return None\n    try:\n        out = subprocess.run([tiiny, \"top\"], capture_output=True, text=True, timeout=30).stdout\n    except Exception:\n        return None\n    models = set()\n    for line in out.splitlines():\n        if \"|\" not in line:\n            continue\n        cells = [c.strip() for c in line.split(\"|\")]\n        # The Model ID column holds the full id, e.g. Qwen/Qwen3.6-35B-A3B\n        for cell in cells:\n            if \"/\" in cell and \" \" not in cell and not cell.startswith(\"Model\"):\n                models.add(cell)\n                break\n    return models or None\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(\n        description=\"Show which Tiiny model a task goal routes to.\",\n    )\n    ap.add_argument(\"goal\", nargs=\"?\", help=\"the task goal, as it would be passed to delegate_task\")\n    ap.add_argument(\"--tier\", choices=VALID_TIERS, help=\"force a tier instead of inferring it\")\n    ap.add_argument(\"--all\", action=\"store_true\", help=\"show every tier and its budget\")\n    ap.add_argument(\"--image\", metavar=\"JOB\", help=\"pick the image model for a job description\")\n    ap.add_argument(\"--alternatives\", action=\"store_true\", help=\"also list the fallback models for the tier\")\n    ap.add_argument(\"--thinking\", choices=[\"auto\", \"on\", \"off\"], default=\"auto\",\n                    help=\"thinking mode override for this check (default: auto)\")\n    args = ap.parse_args()\n\n    if args.all:\n        print(f\"{'tier':<10} {'model':<44} {'NPU':>5}  context\")\n        print(\"-\" * 78)\n        for tier in VALID_TIERS:\n            for model, npu, ctx in TIER_CHOICES[tier]:\n                mark = \"  \" if model == TIER_MODEL[tier] else \"* \"\n                print(f\"{mark}{tier:<8} {model:<44} {npu:>4}%  {ctx}\")\n        print(\"\\n* = fallback for that tier. NPU shares are of one shared pool;\")\n        print(\"  two models can only be resident together if their shares sum to 100% or less.\")\n        return 0","is_error":false}]},"parent_tool_use_id":null,"session_id":"e049b101-1de2-4d7e-adb4-fac63c077fc4","uuid":"e59a40a8-25f7-485b-8d2c-f932c5812bf3","timestamp":"2026-11-21T05:43:43.837Z","tool_use_result":{"stdout":"\"\"\"The plugin source tree works from wherever it is copied.\n\nThe installer copies ``tiiny-router/`` as one tree into\n``$HERMES_HOME/plugins/tiiny-router/``. These tests copy it to an arbitrary\ntemporary path and exercise it there, so any lookup that depends on the\nrepo layout (or on some other fixed path) fails here.\n\nRun with: ``python3 -B test/test_installed_tree.py``\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport temp