ssertNotIn(\"Ornith-1.0-35B\", result.stdout)\n\n    def test_controller_loads_tier_table(self) -> None:","originalFile":"\"\"\"The plugin source tree works from wherever it is copied.\n\nThe installer copies ``tiiny-router/`` as one tree into\n``$HERMES_HOME/plugins/tiiny-router/``. These tests copy it to an arbitrary\ntemporary path and exercise it there, so any lookup that depends on the\nrepo layout (or on some other fixed path) fails here.\n\nRun with: ``python3 -B test/test_installed_tree.py``\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nSOURCE = Path(__file__).resolve().parent.parent / \"tiiny-router\"\n\n_OFFLINE_ENV = {\"PYTHONDONTWRITEBYTECODE\": \"1\"}\n\n\nclass CopiedTree(unittest.TestCase):\n    def setUp(self) -> None:\n        self._tmp = tempfile.TemporaryDirectory()\n        tmp = Path(self._tmp.name)\n        self.home = tmp / \"home\"\n        self.home.mkdir()\n        self.plugin = tmp / \"somewhere\" / \"else\" / \"tiiny-router\"\n        shutil.copytree(\n            SOURCE,\n            self.plugin,\n            ignore=shutil.ignore_patterns(\"__pycache__\"),\n        )\n\n    def tearDown(self) -> None:\n        self._tmp.cleanup()\n\n    def run_script(self, name: str, *args: str):\n        env = {\n            **os.environ,\n            **_OFFLINE_ENV,\n            \"HOME\": str(self.home),\n            \"HERMES_HOME\": str(self.home / \".hermes\"),\n        }\n        return subprocess.run(\n            [sys.executable, \"-B\", str(self.plugin / \"scripts\" / name), *args],\n            cwd=self.home,\n            env=env,\n            capture_output=True,\n            text=True,\n            timeout=60,\n        )\n\n    def test_route_check_runs(self) -> None:\n        result = self.run_script(\"route_check.py\", \"--all\")\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_route_check_routes_a_goal(self) -> None:\n        result = self.run_script(\n            \"route_check.py\", \"write a python function that parses dates\"\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_controller_loads_tier_table(self) -> None:\n        # The controller loads the tier table at import, before argparse\n        # runs, so --help exits non-zero if the table cannot be found.\n        result = self.run_script(\"tiiny_ctl.py\", \"--help\")\n        self.assertEqual(result.returncode, 0, result.stderr)\n\n    def test_backend_loads_controller(self) -> None:\n        # Import the backend as a package from the copy, with a stub for\n        # the one Hermes module it imports, and report whether it found\n        # the controller.\n        probe = self.home / \"probe.py\"\n        probe.write_text(_IMPORT_PROBE)\n        env = {\n            **os.environ,\n            **_OFFLINE_ENV,\n            \"HOME\": str(self.home),\n            \"HERMES_HOME\": str(self.home / \".hermes\"),\n        }\n        result = subprocess.run(\n            [sys.executable, \"-B\", str(probe), str(self.plugin)],\n            cwd=self.home,\n            env=env,\n            capture_output=True,\n            text=True,\n            timeout=60,\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        self.assertEqual(result.stdout.strip(), \"controller loaded\")\n\n\n_IMPORT_PROBE = '''\nimport importlib.util\nimport sys\nimport types\nfrom pathlib import Path\n\nstub = types.ModuleType(\"agent.delegation_provider\")\nstub.DelegationProvider = type(\"DelegationProvider\", (), {})\nstub.DelegationRouteError = type(\"DelegationRouteError\", (Exception,), {})\nsys.modules[\"agent\"] = types.ModuleType(\"agent\")\nsys.modules[\"agent.delegation_provider\"] = stub\n\nplugin = Path(sys.argv[1])\nspec = importlib.util.spec_from_file_location(\n    \"tiiny_router\",\n    plugin / \"__init__.py\",\n    submodule_search_locations=[str(plugin)],\n)\nmodule = importlib.util.module_from_spec(spec)\nsys.modules[\"tiiny_router\"] = module\nspec.loader.exec_module(module)\nprint(\"controller loaded\" if module.ctl is not None else \"no controller\")\n'''\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":65,"oldLines":6,"newStart":65,"newLines":35,"lines":["         )","         self.assertEqual(result.returncode, 0, result.stderr)"," ","+    def code_tier_rows(self) -> list[tuple[str, int, int]]:","+        \"\"\"The ``code`` tier's (model, NPU %, context) rows from --all.\"\"\"","+        result = self.run_script(\"route_check.py\", \"--all\")","+        self.assertEqual(result.returncode, 0, result.stderr)","+        rows = []","+        for line in result.stdout.splitlines():","+            cells = line.lstrip(\"* \").split()","+            if len(cells) == 4 and cells[0] == \"code\":","+                rows.append((cells[1], int(cells[2].rstrip(\"%\")),","+                             int(cells[3])))","+        return rows","+","+    def test_code_tier_offers_ornith_1_5_turbo(self) -> None:","+        rows = self.code_tier_rows()","+        self.assertEqual(rows[0][0], \"Qwen/Qwen3.6-35B-A3B\")","+        self.assertEqual(","+            rows[1], (\"ornith-ai/Ornith-1.5-35B-A3B-Turbo\", 54, 262144)","+        )","+","+    def test_route_check_never_reports_ornith_1_0(self) -> None:","+        models = [row[0] for row in self.code_tier_rows()]","+        self.assertNotIn(\"deepreinforce-ai/Ornith-1.0-35B\", models)","+        result = self.run_script(","+            \"route_check.py\", \"--tier\", \"code\", \"--alternatives\",","+            \"fix the failing build\",","+        )","+        self.assertEqual(result.returncode, 0, result.stderr)","+        self.assertNotIn(\"Ornith-1.0-35B\", result.stdout)","+","     def test_controller_loads_tier_table(self) -> None:","         # The controller loads the tier table at import, before argparse","         # runs,