_installed_tree.py\",\n    \"prepack\": \"npm run build\",\n    \"version\": \"node scripts/stamp-version.ts && git add tiiny-router/plugin.yaml tiiny-router/SKILL.md\"\n  },\n  \"license\": \"MIT\",\n  \"contributors\": [\n    {\n      \"name\": \"Gary Garcia (garciacionet-alt)\"\n    },\n    {\n      \"name\": \"Hermes Agent\"\n    }\n  ],\n  \"devDependencies\": {\n    \"@substrate-system/redeye\": \"^0.1.8\",\n    \"@types/node\": \"^26.6.6\",\n    \"typescript\": \"^7.0.2\"\n  }\n}\n    1107 tiiny-router/SKILL.md\n     264 tiiny-router/references/backend.md\n     329 tiiny-router/references/coding-delegation.md\n     107 tiiny-router/references/image-models.md\n     194 tiiny-router/references/lifecycle.md\n      83 tiiny-router/references/project-role-selection.md\n      90 tiiny-router/references/single-source-deployment.md\n     206 tiiny-router/references/two-box-capability-matrix.md\n     701 docs/IMPLEMENTATION.md\n     302 docs/PATTERN.md\n     421 docs/README.md\n     139 AGENTS.md\n    3943 total\n#!/usr/bin/env node\nimport { type ConfigMode } from './config.js'\nimport { doctor } from './doctor.js'\nimport { type InstallOptions, install } from './install.js'\nimport { SCRIPTS, runInstalledScript } from './passthrough.js'\nimport { uninstall } from './uninstall.js'\n\nconst USAGE = `Usage: hermes-tiiny-router <command>\n\nCommands:\n  install [--force] [--configure | --no-configure]\n             Copy the plugin into $HERMES_HOME/plugins/tiiny-router/.\n             Stops if installed files were edited or the directory was\n             not installed by this package, unless --force is given.\n             Then offers to select it in Hermes config (--configure\n             applies without asking, --no-configure skips; without a\n             terminal the commands are printed instead)\n  uninstall  Remove $HERMES_HOME/plugins/tiiny-router/\n  doctor     Check the install, the Hermes config and the device;\n             exits non-zero when a check fails